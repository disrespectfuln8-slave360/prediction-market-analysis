POLYGON_RPC=
POLYMARKET_START_BLOCK=33605403
KALSHI_API_KEY=your_kalshi_key_id_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Polymarket international CLOB (polymarket.com) — a wallet's raw private key.
POLY_PRIVATE_KEY=
POLY_FUNDER_ADDRESS=
POLY_SIGNATURE_TYPE=0

# Polymarket US (polymarket.us) — Key ID + Secret Key from your account's
# Developer API page.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# Global default (paper/safe) — applies to any platform below without its
# own override. To go live on just one platform, set its own flag instead
# of changing this, e.g. KALSHI_PAPER_TRADING=false — a single shared flag
# risks silently arming live trading on a platform you didn't mean to.
PAPER_TRADING=true
# KALSHI_PAPER_TRADING=false
# POLYMARKET_PAPER_TRADING=false
# POLYMARKET_US_PAPER_TRADING=false

# Apex (run_polyus_apex.py) gets its own paper-mode flag, separate from
# POLYMARKET_US_PAPER_TRADING above — it shares the ladder bot's live
# account but must never be armed by the same switch.
# POLYMARKET_US_APEX_PAPER_TRADING=false

# Optional. Apex trades only on the deterministic, calibrated NOAA-forecast
# probability model in src/trading/polymarket_us/apex/weather_model.py —
# this key is never used to decide a trade or its size, only (if set) to
# have an LLM write the human-readable rationale text for each decision.
# Apex runs fine with this unset; a template rationale is used instead.
ANTHROPIC_API_KEY=
